# --- Database (Neon PostgreSQL) ---
DATABASE_URL=

# --- Public site address, used in emailed links and payment/OAuth callbacks in production ---
NEXT_PUBLIC_SITE_URL=

# --- Google sign-in (OAuth "Web application" client) ---
# Authorized redirect URI: <site>/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email via SendByte (https://docs.sendbyte.africa) ---
# sk_test_… (sandbox, not delivered) or sk_live_… (delivered; EMAIL_FROM must be on a verified domain)
SENDBYTE_API_KEY=
# Must be on a domain verified in SendByte, e.g. "WALE <noreply@www.waleonline.com.ng>"
EMAIL_FROM=
# Inbox that receives contact-page messages (defaults to the public contact email)
CONTACT_INBOX_EMAIL=

# --- Paystack (Dashboard → Settings → API Keys & Webhooks) ---
# sk_test_… or sk_live_…. Webhook URL: <site>/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=

# --- Flutterwave (Dashboard → Settings → API Keys / Webhooks) ---
# FLWSECK_TEST-… or FLWSECK-…. Webhook URL: <site>/api/payments/webhook/flutterwave
FLUTTERWAVE_SECRET_KEY=
# The "Secret hash" you set on the Flutterwave webhook settings page
FLUTTERWAVE_WEBHOOK_HASH=
