# ─────────────────────────────────────────────────────────────────────────────
# Wale frontend (Next.js) — environment template.
# Copy to `.env.local` and adjust. NEVER commit `.env.local`.
#
# SECURITY: only NEXT_PUBLIC_* variables are readable in the browser. Never put
# a secret (API key, database URL, Cloudinary secret, session secret) in a
# NEXT_PUBLIC_ variable — the bundler inlines it into client JavaScript.
# Server-side secrets belong in the backend's own .env (see backend/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── API base URL ─────────────────────────────────────────────────────────────
# MUST include the /api/v1 prefix when pointing at the Express backend.
#
#   Unset / omitted  -> falls back to "/api", the Next.js route handlers that
#                       still serve fixture data (mock mode).
#   Local backend    -> http://localhost:4000/api/v1
#   Production       -> https://api.walehousing.ng/api/v1
#
# The backend must list this app's origin in its FRONTEND_URL allowlist, or the
# browser blocks credentialed requests (CORS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ── Site metadata ────────────────────────────────────────────────────────────
# Canonical public URL, used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Photo uploads: nothing to configure here, deliberately ───────────────────
# Listing photos go from the browser straight to Cloudinary, but the credentials
# live only in the backend (CLOUDINARY_* in backend/.env). The browser asks
# POST /api/v1/media/upload-signature for a one-hour signature per file, so this
# app needs no cloud name, no API key and above all no API secret.
#
# If you are ever tempted to add NEXT_PUBLIC_CLOUDINARY_API_SECRET: don't. That
# value is inlined into client JavaScript and would let anyone upload to the
# account. Photos are served from res.cloudinary.com, which is already allowed
# in `next.config.ts` under images.remotePatterns.
