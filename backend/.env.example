# ─────────────────────────────────────────────────────────────────────────────
# Wale Housing backend — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# All variables are validated at startup by src/config/env.ts (Zod).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL: used by the application at runtime. On Supabase this is the
#   POOLED connection (PgBouncer, port 6543) — append ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   used by Prisma Migrate/Studio only — the DIRECT connection
#   (port 5432). Migrations must not run through the pooler.
# For a local (non-pooled) Postgres, set both to the same value.
#
# Supabase gotchas that cost real debugging time:
#  - The direct host (db.<ref>.supabase.co) is IPv6-only on the free plan. On an
#    IPv4-only network it fails with P1001 even though the project is healthy.
#    Use the Supavisor pooler host (aws-0-<region>.pooler.supabase.com), which is
#    IPv4-reachable, for BOTH urls: 6543 = transaction pooler, 5432 = session
#    pooler (Migrate/Studio need the session pooler or a direct connection).
#  - Free-tier projects auto-pause after ~7 days idle, which removes their DNS
#    records entirely. NXDOMAIN on the project host means "paused", not
#    "misconfigured" — restore it from the dashboard.
#  - After a restore the pooler cold-starts slowly and blows through Prisma's
#    default 5s connect / 10s pool timeouts, again surfacing as P1001 or P2024.
#    connect_timeout=30&pool_timeout=30 rides that out.
DATABASE_URL="postgresql://postgres:password@localhost:5432/wale?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/wale?schema=public"

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to send credentialed requests.
FRONTEND_URL="http://localhost:3000"

# ── Sessions & cookies ───────────────────────────────────────────────────────
# SESSION_SECRET: HMAC key used to hash session/verification/reset tokens before
#   storage. Must be a long random string (>= 32 chars). Rotate with care.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_COOKIE_NAME="wale_session"
SESSION_TTL_DAYS=7
# Cookie attributes. In production behind HTTPS set COOKIE_SECURE=true.
# COOKIE_SAMESITE: "lax" when frontend+backend share a site (e.g. app.walehousing.ng
#   + api.walehousing.ng); "none" (with COOKIE_SECURE=true) when truly cross-site.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.walehousing.ng   # optional; leave unset for host-only cookies

# ── CSRF ─────────────────────────────────────────────────────────────────────
# Double-submit token protection for cookie-authenticated mutations.
# Safe to leave enabled; the frontend fetches /api/v1/auth/csrf and echoes the
# token in the X-CSRF-Token header (see docs/frontend-integration.md).
CSRF_ENABLED=true
CSRF_COOKIE_NAME="wale_csrf"

# ── Email (transactional) ────────────────────────────────────────────────────
# EMAIL_TRANSPORT: "log" prints emails (and verification/reset links) to the
#   logger — the zero-config default for local dev. "smtp" sends via Nodemailer.
EMAIL_TRANSPORT=log
EMAIL_FROM="Wale Housing <no-reply@walehousing.ng>"
# Required only when EMAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Upload signatures per window. Each one is permission to store a file on our
# Cloudinary account, so it gets its own budget rather than sharing RATE_LIMIT_MAX.
# Generous on purpose: a landlord photographing a flat sends a dozen at a time.
UPLOAD_RATE_LIMIT_MAX=120

# ── Cloudinary (listing photos) ──────────────────────────────────────────────
# Photos are uploaded by the browser DIRECTLY to Cloudinary. The browser never
# sees the secret: it asks POST /api/v1/media/upload-signature for a short-lived
# signature (one hour) that authorises exactly one file, in a folder this server
# chooses, with the formats this server allows.
#
# Find all three under Settings -> API Keys in the Cloudinary console.
#
# CLOUDINARY_API_SECRET must never reach the browser and must never be copied
# into a NEXT_PUBLIC_ variable — the Next.js bundler inlines those into client
# JavaScript, and anyone holding it could upload anything to this account.
#
# Leave them blank in development. The upload endpoint then answers 503 with
# "you can save the listing and add photos later" instead of handing out
# signatures that cannot work; everything else on a listing still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
