# ─────────────────────────────────────────────────────────────────────────────
# Wale Housing backend — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# All variables are validated at startup by src/config/env.ts (Zod).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# DATABASE_URL: used by the application at runtime. On Supabase this is the
#   POOLED connection (PgBouncer, port 6543) — append ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   used by Prisma Migrate/Studio only — the DIRECT connection
#   (port 5432). Migrations must not run through the pooler.
# For a local (non-pooled) Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:password@localhost:5432/wale?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/wale?schema=public"

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to send credentialed requests.
FRONTEND_URL="http://localhost:3000"

# ── Sessions & cookies ───────────────────────────────────────────────────────
# SESSION_SECRET: HMAC key used to hash session/verification/reset tokens before
#   storage. Must be a long random string (>= 32 chars). Rotate with care.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_COOKIE_NAME="wale_session"
SESSION_TTL_DAYS=7
# Cookie attributes. In production behind HTTPS set COOKIE_SECURE=true.
# COOKIE_SAMESITE: "lax" when frontend+backend share a site (e.g. app.walehousing.ng
#   + api.walehousing.ng); "none" (with COOKIE_SECURE=true) when truly cross-site.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.walehousing.ng   # optional; leave unset for host-only cookies

# ── CSRF ─────────────────────────────────────────────────────────────────────
# Double-submit token protection for cookie-authenticated mutations.
# Safe to leave enabled; the frontend fetches /api/v1/auth/csrf and echoes the
# token in the X-CSRF-Token header (see docs/frontend-integration.md).
CSRF_ENABLED=true
CSRF_COOKIE_NAME="wale_csrf"

# ── Email (transactional) ────────────────────────────────────────────────────
# EMAIL_TRANSPORT: "log" prints emails (and verification/reset links) to the
#   logger — the zero-config default for local dev. "smtp" sends via Nodemailer.
EMAIL_TRANSPORT=log
EMAIL_FROM="Wale Housing <no-reply@walehousing.ng>"
# Required only when EMAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Cloudinary (media uploads — configured now, wired in a later phase) ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
