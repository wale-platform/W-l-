// Wale Housing — Prisma schema
// Datasource: PostgreSQL (Supabase in hosted environments).
//   url       -> pooled connection, used by the app at runtime.
//   directUrl -> direct connection, used by Prisma Migrate/Studio only.
// See docs/frontend-analysis.md for how these shapes map to the frontend contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────── Users ──

// What a user is allowed to be on the platform.
//
// A single account is NOT limited to one relationship with Wale: the same person
// may rent a flat, offer moving services, and later list a property. That is
// modelled as `User.role` (the PRIMARY role, which decides the default dashboard
// and nav) plus `UserRole` rows (every role the account additionally holds).
// Authorization always checks the union of the two — see `userRoles()` in
// src/modules/users/role.service.ts — so granting a role never means editing an
// account's identity.
//
// TENANT was previously named USER; the migration renames the enum value in
// place so existing rows keep their role.
enum Role {
  TENANT
  LANDLORD
  LAWYER
  MOVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  // Stored split (per the product data model); the API also returns a
  // computed `name` = "firstName lastName" for the frontend's single-field User.
  firstName      String
  lastName       String     @default("")
  phone          String?
  passwordHash   String
  // PRIMARY role: the one this account signed up as, used for the default
  // landing dashboard. Additional roles live in `roles` (UserRole).
  role           Role       @default(TENANT)
  status         UserStatus @default(ACTIVE)
  avatar         String?
  // Student-focused signup collects a university id (e.g. "unilag"); optional
  // so landlords/admins created later are not forced to have one.
  university     String?
  emailVerified  Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  properties              Property[]
  roles                   UserRole[]
  grantedRoles            UserRole[] @relation("RoleGrantedBy")
  verificationDecisions   PropertyVerification[]
  inspectionRequests      Inspection[] @relation("InspectionRequests")
  residenceClaims         ResidenceHistory[] @relation("ResidenceClaims")
  // Claims this account decided on — the other side of `residenceClaims`, kept
  // separate so "places I say I lived" and "claims I confirmed as the landlord"
  // are never the same list. A user can appear in both, and must not be able to
  // appear in both for the SAME row (see residence.service.ts).
  residenceDecisions      ResidenceHistory[] @relation("ResidenceDecisions")
  reviewsWritten          PropertyReview[]   @relation("ReviewsWritten")
  reviewReports           ReviewReport[]     @relation("ReviewReports")

  @@index([role])
  @@index([status])
}

// Every role an account holds, including a mirror row for `User.role` so the
// union is a single query. Composite primary key makes a duplicate grant
// impossible without a surrogate id to maintain.
//
// Granting is NOT uniformly self-serve — that policy lives in role.service.ts:
// TENANT/LANDLORD/MOVER can be self-claimed (a landlord still has to get each
// listing through property verification, and a mover's residence claims still
// have to be verified, so the claim alone confers no trust), while LAWYER and
// ADMIN can only be granted by an existing ADMIN.
model UserRole {
  userId    String
  role      Role
  grantedAt DateTime @default(now())
  // The admin who granted it; null for self-claimed roles and for signup.
  grantedByUserId String?

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
}

// ────────────────────────────────────────────────────────────── Sessions ──

// Opaque session tokens: the raw secret lives only in the httpOnly cookie.
// We persist an HMAC-SHA256 hash so a database leak cannot reconstruct a
// usable session. Enables logout, logout-all, and per-device revocation.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Short-lived, single-use tokens. Only the hash is stored (never the raw
// token). `usedAt` marks consumption; expired/used rows are pruned lazily.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────────────────── Properties ──

// Enum VALUES for type/source deliberately match the frontend's Zod enums
// verbatim so they cross the wire with zero mapping. Status is internal and is
// serialized to the frontend's `verified` boolean (verified = VERIFIED).
enum PropertyType {
  studio
  one_bedroom
  two_bedroom
  shared
}

enum PropertySource {
  wale
  agent
  landlord
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

model Property {
  id          String         @id @default(cuid())
  // The managing account, when one exists. Nullable because a listing's
  // landlord/agent contact may not be a platform user (see contact* fields).
  ownerId     String?
  title       String
  description String
  price       Int // annual rent, whole NGN
  type        PropertyType
  bedrooms    Int            @default(1)
  bathrooms   Int            @default(1)
  source      PropertySource @default(wale)
  status      PropertyStatus @default(DRAFT)

  // Location (kept flat; PostGIS can be layered on later if geo queries arrive).
  address      String
  city         String
  state        String
  country      String  @default("Nigeria")
  neighborhood String?
  latitude     Float?
  longitude    Float?
  university   String? // university id, e.g. "unilag"

  amenities     String[] @default([])
  // Canonical, searchable amenity tags derived from `amenities` on every write
  // (see src/modules/properties/amenity-tags.ts). `amenities` is what the
  // landlord wrote and what the listing shows; this is what the filter matches,
  // because equality against free text ("Estate security" vs "Security gate")
  // would make the amenity filter return nothing.
  amenityTags   String[] @default([])
  availableDate DateTime @db.Date

  // Denormalized public contact shown on the listing (frontend `landlord`).
  contactName  String
  contactPhone String
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  images PropertyImage[]
  verifications PropertyVerification[]
  inspections   Inspection[]
  residences    ResidenceHistory[]
  reviews       PropertyReview[]

  @@index([status])
  @@index([university])
  @@index([city])
  @@index([type])
  @@index([price])
  @@index([createdAt])
  // GIN, because the amenity filter asks "does this array contain all of these"
  // (`hasEvery` -> `@>`), which a B-tree on an array cannot answer.
  @@index([amenityTags], type: Gin)
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ──────────────────────────────────────────── Verification (audit trail) ──

// Every change a listing's status has ever gone through, one row each.
//
// Append-only. Nothing updates or deletes a row, because the point of the table
// is to answer "who decided this, when, and what did they say" months later —
// including when the answer is inconvenient. Three readers:
//
//  - the landlord, who is shown the reason their listing was rejected or
//    suspended. Without this, "Rejected" is a dead end: they cannot tell whether
//    to change a photo or a price, and support has to guess too.
//  - an admin looking at a listing that has been round the loop several times.
//  - us, when a landlord disputes a decision.
//
// `reason` is required by the service for REJECTED and SUSPENDED (see
// property.schemas.ts) and optional otherwise: approving needs no explanation,
// taking somebody's listing down does.
//
// Cascade on delete. The trail describes a listing, and once the listing is gone
// there is no reader left for its history — an orphan row would be kept out of
// principle rather than for a purpose. Note what that does NOT cover: a landlord
// who is rejected, deletes, and re-lists the same flat to get a fresh reviewer.
// Catching that needs address matching, not a retained row, and it is not
// attempted here.
model PropertyVerification {
  id         String         @id @default(cuid())
  propertyId String
  fromStatus PropertyStatus
  toStatus   PropertyStatus
  // What the owner is shown. Never an internal note — assume they will read it.
  reason     String?
  // Who acted. Null when the actor's account is later deleted; the row survives
  // because what was decided matters even when who decided it is gone.
  actorId    String?
  createdAt  DateTime       @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The owner's "why was this rejected" query: newest row for one listing.
  @@index([propertyId, createdAt])
  // The admin queue's counterpart: recent decisions across all listings.
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────── Inspections ──

// Where an inspection request is up to.
//
// REQUESTED is the tenant's ask. The landlord then does one of three things:
// CONFIRMED (that time works), DECLINED (it does not — with a reason, so the
// tenant is not left guessing), or nothing, which is what CANCELLED and
// COMPLETED exist to close off later.
//
// COMPLETED means the viewing happened. Nothing on the platform can observe
// that, so it is a landlord's assertion and is treated as one — see
// inspection.service.ts. It is here because "did this viewing actually happen"
// is the question a residence claim in the mover domain will need to lean on,
// and a status nobody can ever set is worse than no status at all.
enum InspectionStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

// A tenant asking to see a property in person.
//
// The whole point of the product is that nobody rents a room they have not
// stood in, so this is the one action a listing page must support beyond
// reading it. It replaces the phone-call-and-hope flow: the request is dated,
// it is attributable to an account, and the landlord's answer is recorded next
// to it.
//
// `preferredAt` is what the TENANT asked for and never changes; a landlord who
// wants a different time declines and says so, rather than silently rewriting
// the appointment under the tenant. That keeps the row honest about who
// proposed what — and a tenant who turns up at the original time because they
// never noticed an edit is exactly the failure this avoids.
//
// No money passes through here and none ever should. The advance-fee scam the
// listing page warns about IS the inspection fee, so the model has no amount
// column to tempt anyone into adding one.
model Inspection {
  id         String           @id @default(cuid())
  propertyId String
  // The account that asked. Required: an anonymous request cannot be answered,
  // and the landlord needs a name and a number to expect at the gate.
  tenantId   String
  status     InspectionStatus @default(REQUESTED)

  // When the tenant would like to come. A datetime, not a date: "Saturday" is
  // not something a landlord can be at the property for.
  preferredAt DateTime
  // Anything the tenant wants the landlord to know ("I can only do mornings").
  note        String?

  // The landlord's answer, in their own words. Required by the service when
  // declining — "Declined" with no explanation tells the tenant nothing about
  // whether to propose another time or move on.
  response    String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation("InspectionRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  // Residence claims that cite this viewing as corroboration. A list rather than
  // a single row because the same COMPLETED viewing can be cited by two claims if
  // someone lived at the property twice — see ResidenceHistory.
  corroborates ResidenceHistory[]

  // One live request per tenant per property, enforced in the database rather
  // than by a check-then-insert that two taps on a slow connection can race
  // past. Scoped to REQUESTED only — via a partial index in the migration,
  // which Prisma cannot express — because a tenant whose viewing was declined
  // must be able to ask again for a different time.
  @@index([propertyId, status])
  // The landlord's queue: their listings' requests, newest ask first.
  @@index([tenantId, createdAt])
}

// ────────────────────────────────────────────────── Residence & reviews ──

// How much weight a residence claim carries.
//
// UNVERIFIED is where every claim starts and there is no path that skips it. A
// person saying "I lived here" is an assertion about somebody else's property,
// and the platform has no way to observe it — so the status names what we
// actually know, which at that point is nothing.
//
// CONFIRMED means the LISTING'S OWNER (or an admin) said yes. That is the only
// party in a position to know, and they are also the party with an interest in
// saying no, which is what makes a yes worth something.
//
// REJECTED means they said no. The row is kept: a rejected claim is the record
// that someone tried, and deleting it would let them try again with a clean
// slate every time.
enum ResidenceStatus {
  UNVERIFIED
  CONFIRMED
  REJECTED
}

// A person's claim to have lived at a property.
//
// This is the foundation the review system stands on, and the reason it exists
// at all: a review of a Nigerian student flat is worth reading only if the
// person writing it actually lived there through a rainy season. So the claim
// comes first and the review hangs off it.
//
// WHAT STOPS SOMEONE CLAIMING AN ARBITRARY PROPERTY. Not one thing — several,
// because no single one of them is sufficient:
//
//  1. A claim confers nothing on its own. It is UNVERIFIED, it is labelled as
//     such everywhere it is shown, and its review is excluded from the verified
//     average. Claiming is cheap; being believed is not.
//  2. Only the property's owner or an admin can confirm, and the claimant can
//     never confirm their own — enforced by the query scope, not by a role check
//     (see residence.service.ts).
//  3. `corroboratedByInspectionId` records a COMPLETED viewing by the same
//     person on the same property, if one exists. That is the platform's own
//     evidence that they physically turned up, and it is the strongest signal
//     available without asking for a tenancy agreement. It is shown to the owner
//     when they decide, and it is set by the server — never sent by a client.
//  4. Outstanding claims are capped per account, so a bad actor cannot spray a
//     claim across the whole catalogue and hope some landlords click yes.
//
// What this does NOT claim: an owner can confirm a claim that is false, whether
// out of carelessness or collusion with a fake reviewer. Making that impossible
// needs documents we do not ask for. What is achieved is that a false confirmed
// claim requires the owner's participation and leaves their name on it.
model ResidenceHistory {
  id         String          @id @default(cuid())
  userId     String
  propertyId String
  status     ResidenceStatus @default(UNVERIFIED)

  // The tenancy, as calendar dates — nobody remembers the hour they moved in.
  movedInAt  DateTime  @db.Date
  // Null means "still living here". A review can still be written: someone six
  // months into a tenancy knows about the water supply.
  movedOutAt DateTime? @db.Date

  // The claimant's own words, for the owner reading the claim ("flat 3, upstairs
  // — you may remember my brother helped me move in").
  note String?

  // Set by the SERVER when a COMPLETED inspection by this person on this
  // property exists. Never accepted from a request body: it is the one piece of
  // independent evidence here, so a client that could set it would be able to
  // manufacture its own corroboration.
  corroboratedByInspectionId String?

  // The decision.
  confirmedById String?
  decidedAt     DateTime?
  // Why, in the decider's words. Required by the service when rejecting: the
  // claimant is shown this, and "Rejected" alone tells them nothing about
  // whether they got the address wrong or are suspected of lying.
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation("ResidenceClaims", fields: [userId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  confirmedBy User?       @relation("ResidenceDecisions", fields: [confirmedById], references: [id], onDelete: SetNull)
  corroboratedBy Inspection? @relation(fields: [corroboratedByInspectionId], references: [id], onDelete: SetNull)
  review      PropertyReview?

  // The same person, the same property, the same move-in date is one claim
  // submitted twice — not a second tenancy. Scoped this way rather than to
  // (userId, propertyId) because living somewhere twice years apart is a real
  // thing that happens, and each stay is its own reviewable period.
  @@unique([userId, propertyId, movedInAt])
  // The claimant's own list.
  @@index([userId, createdAt])
  // The owner's queue, and the review reader's "is this claim confirmed" lookup.
  @@index([propertyId, status])
}

// Whether a review is visible, and why not if it is not.
//
// PUBLISHED is the normal state. HIDDEN is an admin taking a review out of
// public view after a report — the row survives so the decision is auditable and
// so the author is not silently censored. REMOVED is the author withdrawing
// their own.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

// What it was actually like to live there.
//
// One review per residence period — `residenceId` is unique, so the schema makes
// a second one impossible rather than trusting a check. Someone who lived
// somewhere twice gets two claims and therefore two reviews, which is right:
// the flat may genuinely have been better the second time.
//
// TRUST. A review is `verified` when its residence claim is CONFIRMED, and that
// is DERIVED at read time from the claim's current status rather than stored
// here. Deliberate: confirming a claim promotes its review automatically, and
// rejecting one demotes it, with no denormalized copy to drift. A stored flag
// would eventually say "verified" about a claim that had since been rejected —
// which is the exact thing the brief forbids.
//
// Ratings are 1-5 on the dimensions that decide whether a Nigerian student flat
// is liveable. They are separate rather than a single score because "the
// landlord is unreachable but the borehole never fails" is a real and useful
// thing to be able to say, and an average of the two tells nobody anything.
model PropertyReview {
  id          String       @id @default(cuid())
  // Unique: the one-review-per-tenancy rule, in the database.
  residenceId String       @unique
  // Denormalized from the residence so "reviews for this listing" is one index
  // hit rather than a join through claims. The service always copies it from the
  // residence and never from the request.
  propertyId  String
  authorId    String
  status      ReviewStatus @default(PUBLISHED)

  overall  Int
  water    Int
  power    Int
  security Int
  // How the landlord actually behaved — the thing no listing photo shows.
  landlord Int

  // Required, and with a floor in the schemas: a rating with no words is a score,
  // and the point of this feature is the sentence a student writes about the
  // water going off in Harmattan.
  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residence ResidenceHistory @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  property  Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author    User             @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  reports   ReviewReport[]

  // The listing page's read: this property's visible reviews, newest first.
  @@index([propertyId, status, createdAt])
  @@index([authorId])
}

// Someone flagging a review.
//
// Kept as rows rather than a counter on the review, because "who reported this
// and what did they say" is what an admin needs in order to act, and a number
// only says how many people were annoyed. One report per person per review, so a
// landlord cannot manufacture a pile of reports by clicking repeatedly.
//
// Reporting does NOT hide a review. Nothing about this table changes what the
// public sees — an admin has to decide. A landlord who could bury a bad review
// by reporting it would make the whole review system worthless.
model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  reporterId String
  reason     String
  // Set when an admin has looked at it, so the queue can show what is
  // outstanding without deleting the ones that were handled.
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  review   PropertyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User           @relation("ReviewReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  // The admin queue: outstanding reports, oldest first.
  @@index([resolvedAt, createdAt])
}

// Deferred domains (messaging, notifications, wallet, media assets) are
// intentionally NOT modelled yet — they are added in their own phases to
// avoid speculative, unused tables. The relations above are shaped so they can
// be introduced additively.
